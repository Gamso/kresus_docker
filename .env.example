# Copy to .env (optional): values read by docker-compose.yml
TZ=Europe/Paris
# Image version to run (see Releases in the README)
IMAGE_TAG=1.0.0
KRESUS_PORT=9876
SURE_SYNC_TIME=07:30
SURE_RUN_ON_START=0
# Esalia: 1 = keep cookies between full logins (experiment against the daily OTP prompt)
ESALIA_KEEP_COOKIES=0
