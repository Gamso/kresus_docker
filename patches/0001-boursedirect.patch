+            except (OSError, ValueError):
+                previous = []
+
+            # Same row seen in both exports: keep it once. Identical rows on the same day count separately.
+            seen, merged = Counter(key(r) for r in rows), list(rows)
+            old_count = Counter()
+            for row in previous:
+                k = key(row)
+                old_count[k] += 1
+                if old_count[k] > seen[k]:
+                    merged.append(row)
+                    seen[k] += 1
+            merged.sort(key=lambda r: (r["date"] or "", r["operation_date"] or ""))
+
+            with open(path + ".tmp", "w") as f:
+                json.dump({"account": str(account.id), "rows": merged}, f, ensure_ascii=False, indent=1)
+            os.replace(path + ".tmp", path)
