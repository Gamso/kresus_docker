+    def _export_history(self, account):
+        """Writes the rows of the account history page to boursedirect-history-<account>.json.
+
+        The page only shows about two months, so each export is merged with the previous file: rows that scrolled
+        out of the window are kept. Used by the bridge to replay the operations with their real dates.
+        """
+        import json
+        import os
+        from collections import Counter
+        from decimal import Decimal
+
+        if account.type not in (account.TYPE_PEA, account.TYPE_MARKET):
+            return
+
+        def num(value):
+            return float(value) if isinstance(value, (int, float, Decimal)) else None
+
+        def key(row):
+            return tuple(row[k] for k in ("date", "operation_date", "operation", "security", "quantity", "price", "amount"))
+
+        try:
+            self.history.go(nc=account._select)
+            rows = []
+            for tr in self.page.iter_history():
+                investment = tr.investments[0] if isinstance(tr.investments, list) and tr.investments else None
+                rows.append(
+                    {
+                        "date": tr.date.isoformat() if tr.date else None,  # allocation date
+                        "operation_date": tr.rdate.isoformat() if tr.rdate else None,
+                        "operation": tr._operation,
+                        "security": tr._security,
+                        "quantity": num(investment.quantity) if investment else None,
+                        "price": num(investment.unitvalue) if investment else None,
+                        "amount": num(tr.amount),
+                    }
+                )
+
+            path = "/var/lib/kresus/boursedirect-history-%s.json" % account.id
+            try:
