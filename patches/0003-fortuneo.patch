+    def handle_sca_required(self, error, fingerprint):
+        """Fortuneo answers 403 SCA_REQUESTED when a strong authentication (SMS code) is needed.
+
+        Send the SMS like the website does, then ask the code to the user. The answer comes back
+        in a later login (do_login -> finish_sca): the state (session id, PKCE verifier, cookies) is saved.
+        """
+        response = error.response
+        if response is None or response.status_code != 403:
+            return
+        try:
+            body = response.json()
+        except ValueError:
+            return
+        if body.get("error_code") != "SCA_REQUESTED":
+            return
+
+        medias = body.get("sca_medias") or []
+        if not medias:
+            raise ActionNeeded(
+                "Aucun numéro de téléphone n'est enregistré chez Fortuneo pour valider la connexion par code SMS."
+            )
+        media = medias[0]
+
+        # Do not send an SMS if nobody can answer it (automatic synchronisation).
+        self.check_interactive()
+
+        self.open(
+            "%s/security/operation/otp" % self.api_url,
+            method="POST",
+            json={
+                "operationId": body["operationId"],
+                "valueMedia": media["numero_crypte"],
+                "typeMedia": media["type_media"],
+                "template": "FTOFROTP",
+            },
+            headers={"apikey": self.client_id, "Authorization": "Bearer %s" % body["sca_tmp_token"]},
+        )
+        self.sca_state = {
