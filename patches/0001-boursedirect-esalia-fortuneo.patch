+    def _advance(self, data):
+        from woob.exceptions import NeedInteractiveFor2FA, SentOTPQuestion
+
+        for _ in range(6):
+            if "tokenId" in data:
+                return data
+            stage = data.get("stage")
+            if stage == "DeviceCollect":
+                data = self._submit_device_collect(data)
+            elif stage == "OTPInfo":
+                if not self.is_interactive:
+                    raise NeedInteractiveFor2FA()
+                data = self._submit_as_is(data)
+            elif stage == "OTP":
+                self.otp_json = data
+                data["_kv"] = {"v": self.code_verifier, "s": self.oauth_state}
+                raise SentOTPQuestion("otp", message="Entrez le code de validation recu par SMS ou e-mail")
+            else:
+                raise AssertionError("Esalia: etape non geree: stage=%s structure=%s" % (stage, self._summary(data)))
+        raise AssertionError("Esalia: trop d'etapes, stage=%s" % data.get("stage"))
+
+    def handle_otp(self):
+        from woob.browser.exceptions import ClientError
+        from woob.exceptions import BrowserIncorrectPassword
+
+        data = self.otp_json
+        kv = data.pop("_kv", {})
+        self.code_verifier = kv.get("v")
+        self.oauth_state = kv.get("s")
+        code = self.config["otp"].get()
+        for cb in data["callbacks"]:
+            if cb["type"] == "PasswordCallback" and cb.get("input"):
+                cb["input"][0]["value"] = code
+        self._set_choice(data, "rememberTerminal", 1 if self.REMEMBER_DEVICE else 0)
+        self._set_choice(data, "iam_action", 0)
+        try:
+            self.authentication_page.go(json=data, headers=self.HDRS)
+        except ClientError as e:
+            if e.response.status_code == 401:
+                raise AssertionError(
+                    "Esalia: OTP 401 len=%d digits=%s body=%s"
+                    % (len(code or ""), str(code or "").isdigit(), e.response.text[:300])
+                )
+            raise
+        new = self.response.json()
+        if new.get("stage") == "OTP":
+            err = ""
+            for cb in new.get("callbacks", []):
+                o = {x["name"]: x["value"] for x in cb.get("output", [])}
+                if o.get("id") == "error-iam":
+                    err = str(o.get("value", ""))
+            raise AssertionError(
+                "Esalia: OTP refuse len=%d digits=%s error-iam=%s"
+                % (len(code or ""), str(code or "").isdigit(), err[:200])
+            )
+        self.otp_json = None
+        self._advance(new)
+        self._finish_oauth()
+
+    CALLBACK = "https://salaries.esalia.com/sso/oauth2/code/iam"
+    API = "https://salaries.esalia.com"
+    CLIENT_ID = "sg_nfe_web"
+    esalia_tokens = None
+    _token_fresh = False
+
+    # --- Jetons OAuth2 ---------------------------------------------------
+    def dump_state(self):
+        state = super().dump_state()
+        state["esalia_tokens"] = self.esalia_tokens
+        return state
+
+    def load_state(self, state):
+        self.esalia_tokens = state.get("esalia_tokens")
+        super().load_state(state)
+
+    def _token_request(self, data):
+        payload = dict(data)
+        payload["client_id"] = self.CLIENT_ID
+        tok = self.open(self.API + "/api/auth/token", data=payload).json()
+        if not tok.get("access_token"):
+            raise AssertionError("Esalia: reponse token sans access_token: %s" % sorted(tok.keys()))
+        self.esalia_tokens = {"access": tok["access_token"], "refresh": tok.get("refresh_token")}
+        self._token_fresh = True
+        self._save_tokens_file()
+
+    def _finish_oauth(self):
+        from urllib.parse import parse_qs, urljoin, urlsplit
+
+        r = self.open(self.redirect_uri, allow_redirects=False)
+        loc, hops = r.headers.get("Location", ""), 0
+        while loc and not loc.startswith(self.CALLBACK) and hops < 5:
+            r = self.open(urljoin(r.url, loc), allow_redirects=False)
+            loc, hops = r.headers.get("Location", ""), hops + 1
+        q = parse_qs(urlsplit(loc).query)
+        code = (q.get("code") or [None])[0]
+        if not code or (q.get("state") or [None])[0] != self.oauth_state:
+            raise AssertionError("Esalia: retour OAuth2 inattendu (status=%s code=%s)" % (r.status_code, bool(code)))
+        self._token_request({
+            "grant_type": "authorization_code",
+            "code_verifier": self.code_verifier,
+            "redirect_uri": self.CALLBACK,
+            "code": code,
+        })
+
+    TOKENS_FILE = "/var/lib/kresus/esalia-tokens.json"
+
+    def _load_tokens_file(self):
+        import json
+
+        try:
+            with open(self.TOKENS_FILE) as f:
+                return json.load(f)
+        except (OSError, ValueError):
+            return None
+
+    def _save_tokens_file(self):
+        import json
+        import os
+
+        try:
+            fd = os.open(self.TOKENS_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+            with os.fdopen(fd, "w") as f:
+                json.dump(self.esalia_tokens, f)
+        except OSError:
+            pass
+
+    def _ensure_token(self):
+        from woob.browser.exceptions import ClientError
+
+        if self.esalia_tokens and self.esalia_tokens.get("access") and self._token_fresh:
+            return
+        from_file = self._load_tokens_file()
+        tokens = from_file or self.esalia_tokens or {}
+        source = "fichier" if from_file else ("session" if self.esalia_tokens else "aucune")
+        if tokens.get("refresh"):
+            try:
+                self._token_request({"grant_type": "refresh_token", "refresh_token": tokens["refresh"]})
+                self.logger.debug("token refreshed (source=%s)", source)
+                return
+            except ClientError as e:
+                er = getattr(e, "response", None)
+                self.logger.debug("token refresh refused: status=%s (source=%s)", getattr(er, "status_code", None), source)
+                self.esalia_tokens = None
+        else:
+            self.logger.debug("no refresh token (source=%s)", source)
+        self.do_login()
+
+    def _api_get(self, href):
+        self._ensure_token()
+        if href.startswith("http"):
+            url = href
+        elif href.startswith("/api/"):
+            url = self.API + href
+        elif href.startswith("/"):
+            url = self.API + "/api/epargnant/v1" + href
+        else:
+            url = self.API + "/api/epargnant/v1/" + href
+        return self.open(url, headers={"Authorization": "Bearer " + self.esalia_tokens["access"]}).json()
+
+    # --- Donnees -----------------------------------------------------------
+    def iter_accounts(self):
+        import re
+        from decimal import Decimal
+
+        from woob.capabilities.bank import Account
+
+        plans = self._api_get("/api/epargnant/v1/plans-epargne")
+        accounts = []
+        positions_out, support_cache = [], {}
+        for plan in plans:
+            label, kind, disp_per = None, "", False
+            href = ((plan.get("_links") or {}).get("dispositif_epargne") or {}).get("href")
+            if href:
+                try:
+                    disp = self._api_get(href)
+                    if isinstance(disp, dict):
+                        disp_per = bool(disp.get("composant_per"))
+                        for k in ("titre", "libelle", "libelle_long", "libelle_court", "nom", "intitule", "label"):
+                            if isinstance(disp.get(k), str) and disp[k].strip():
+                                label = disp[k].strip()
+                                break
+                        for k in ("type", "type_dispositif", "code_type", "famille", "categorie", "code"):
+                            if isinstance(disp.get(k), str):
+                                kind = disp[k]
+                                break
+                except Exception as e:
+                    self.logger.warning("dispositif lookup failed: %s", type(e).__name__)
+
+            amount = plan.get("montant_total_brut") or {}
+            acc = Account()
+            acc.id = str(plan["id"])
+            acc.number = acc.id
+            acc.label = label or "Esalia %s" % plan.get("id_dispositif_epargne", acc.id)
+            acc.balance = Decimal(str(amount.get("montant", 0)))
+            acc.currency = amount.get("devise") or "EUR"
+            words = set(re.findall(r"[A-Z]+", ("%s %s %s" % (kind, acc.label, plan.get("id_dispositif_epargne", ""))).upper()))
+            retraite = bool(words & {"PER", "PERCO", "PERCOL", "PERCOI", "PERECO", "PERECOL", "PERO", "RETRAITE"})
+            acc.type = getattr(Account, "TYPE_PER", Account.TYPE_PERCO) if (retraite or disp_per) else Account.TYPE_PEE
+            gain = plan.get("plus_value") or {}
+            if "montant" in gain:
+                acc.valuation_diff = Decimal(str(gain["montant"]))
+            pos_href = ((plan.get("_links") or {}).get("positions") or {}).get("href")
+            if pos_href:
+                try:
+                    for pos in self._api_get(pos_href) or []:
+                        parts = pos.get("nb_parts") or 0
+                        val = (pos.get("montant_total_brut") or {}).get("montant") or 0
+                        if not parts and not val:
+                            continue
+                        pv = (pos.get("plus_value") or {}).get("montant") or 0
+                        sup_id = pos.get("id_support_investissement")
+                        sup = support_cache.get(sup_id)
+                        if sup is None:
+                            sup = {}
+                            s_href = ((pos.get("_links") or {}).get("support_investissement") or {}).get("href")
+                            if s_href:
+                                try:
+                                    sup = self._api_get(s_href) or {}
+                                except Exception as e:
+                                    self.logger.warning("support lookup failed: %s", type(e).__name__)
+                            support_cache[sup_id] = sup
+                        name = next((sup[k] for k in ("libelle", "titre", "nom", "libelle_long", "label")
+                                     if isinstance(sup.get(k), str) and sup[k].strip()), sup_id)
+                        isin = next((sup[k] for k in ("code_isin", "isin", "code")
+                                     if isinstance(sup.get(k), str) and sup[k].strip()), None)
+                        cost = val - pv
+                        positions_out.append({
+                            "plan_id": str(plan["id"]),
+                            "plan": acc.label,
+                            "position_id": str(pos.get("id")),
+                            "support_id": sup_id,
+                            "fonds": name,
+                            "isin": isin,
+                            "parts": parts,
+                            "valeur": val,
+                            "plus_value": pv,
+                            "cout": round(cost, 2),
+                            "pru": round(cost / parts, 6) if parts else None,
+                            "vl": round(val / parts, 6) if parts else None,
+                            "devise": (pos.get("montant_total_brut") or {}).get("devise") or "EUR",
+                        })
+                except Exception as e:
+                    self.logger.warning("positions lookup failed: %s", type(e).__name__)
+            accounts.append(acc)
+
+        try:
+            import json
+            import os
+            import time
+
+            tmp = "/var/lib/kresus/esalia-positions.json.tmp"
+            with open(tmp, "w") as f:
+                json.dump({"date": time.strftime("%Y-%m-%d"), "positions": positions_out}, f, ensure_ascii=False, indent=1)
+            os.replace(tmp, "/var/lib/kresus/esalia-positions.json")
+        except OSError as e:
+            self.logger.warning("export positions failed: %s", e)
+        return accounts
+
+    def iter_history(self, *args, **kwargs):
+        return []
+
+    def iter_investment(self, *args, **kwargs):
+        return []
+
+    def iter_pocket(self, *args, **kwargs):
+        return []
+
+    def do_login(self):
+        if self.config["otp"].get() and self.otp_json:
+            return self.handle_otp()
+        # Experiment: ESALIA_KEEP_COOKIES=1 keeps the cookies between full logins, in case Esalia
+        # recognizes a trusted terminal through a persistent cookie and not only the device id.
+        if os.environ.get("ESALIA_KEEP_COOKIES") != "1":
+            self.session.cookies.clear()
+        self._advance(self.init_login())
+        self._finish_oauth()
