+    def _summary(self, data):
+        out = []
+        for cb in data.get("callbacks", []):
+            o = {x["name"]: x["value"] for x in cb.get("output", [])}
+            item = {"type": cb["type"], "inputs": [i["name"] for i in cb.get("input", [])]}
+            if isinstance(o.get("id"), str):
+                item["id"] = o["id"]
+            if isinstance(o.get("prompt"), str) and len(o["prompt"]) < 60:
+                item["prompt"] = o["prompt"]
+            if "choices" in o:
+                item["choices"] = o["choices"]
+            for k, v in o.items():
+                if isinstance(v, bool):
+                    item[k] = v
+            for k in ("value", "message", "data"):
+                if isinstance(o.get(k), str):
+                    item[k + "_len"] = len(o[k])
+                    if k == "message":
+                        low = o[k].lower()
+                        item["mentions"] = [w for w in ("sms", "mail", "telephone", "téléphone", "code") if w in low]
+            out.append(item)
+        return out
+
+    def _device_id(self):
+        import secrets
+
+        path = "/var/lib/kresus/esalia-device-id"
+        try:
+            with open(path) as f:
