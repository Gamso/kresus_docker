+    def _submit_device_collect(self, data):
+        for cb in data.get("callbacks", []):
+            if cb["type"] == "DeviceProfileCallback" and cb.get("input"):
+                o = {x["name"]: x["value"] for x in cb.get("output", [])}
+                if o.get("location"):
+                    raise AssertionError("Esalia: localisation demandee: %s" % self._summary(data))
+                cb["input"][0]["value"] = self._device_profile(bool(o.get("metadata", True)))
+                self.authentication_page.go(json=data, headers=self.HDRS)
