+    def iter_accounts(self):
+        import re
+        from decimal import Decimal
+
+        from woob.capabilities.bank import Account
+
+        plans = self._api_get("/api/epargnant/v1/plans-epargne")
+        accounts = []
+        positions_out, support_cache = [], {}
+        for plan in plans:
+            label, kind, disp_per = None, "", False
+            href = ((plan.get("_links") or {}).get("dispositif_epargne") or {}).get("href")
+            if href:
+                try:
+                    disp = self._api_get(href)
+                    if isinstance(disp, dict):
+                        disp_per = bool(disp.get("composant_per"))
+                        for k in ("titre", "libelle", "libelle_long", "libelle_court", "nom", "intitule", "label"):
+                            if isinstance(disp.get(k), str) and disp[k].strip():
+                                label = disp[k].strip()
+                                break
+                        for k in ("type", "type_dispositif", "code_type", "famille", "categorie", "code"):
+                            if isinstance(disp.get(k), str):
+                                kind = disp[k]
+                                break
+                except Exception as e:
+                    self.logger.warning("dispositif lookup failed: %s", type(e).__name__)
+
+            amount = plan.get("montant_total_brut") or {}
+            acc = Account()
+            acc.id = str(plan["id"])
+            acc.number = acc.id
+            acc.label = label or "Esalia %s" % plan.get("id_dispositif_epargne", acc.id)
+            acc.balance = Decimal(str(amount.get("montant", 0)))
+            acc.currency = amount.get("devise") or "EUR"
+            words = set(re.findall(r"[A-Z]+", ("%s %s %s" % (kind, acc.label, plan.get("id_dispositif_epargne", ""))).upper()))
+            retraite = bool(words & {"PER", "PERCO", "PERCOL", "PERCOI", "PERECO", "PERECOL", "PERO", "RETRAITE"})
+            acc.type = getattr(Account, "TYPE_PER", Account.TYPE_PERCO) if (retraite or disp_per) else Account.TYPE_PEE
+            gain = plan.get("plus_value") or {}
+            if "montant" in gain:
+                acc.valuation_diff = Decimal(str(gain["montant"]))
+            pos_href = ((plan.get("_links") or {}).get("positions") or {}).get("href")
+            if pos_href:
+                try:
+                    for pos in self._api_get(pos_href) or []:
+                        parts = pos.get("nb_parts") or 0
+                        val = (pos.get("montant_total_brut") or {}).get("montant") or 0
+                        if not parts and not val:
+                            continue
+                        pv = (pos.get("plus_value") or {}).get("montant") or 0
+                        sup_id = pos.get("id_support_investissement")
+                        sup = support_cache.get(sup_id)
+                        if sup is None:
+                            sup = {}
+                            s_href = ((pos.get("_links") or {}).get("support_investissement") or {}).get("href")
+                            if s_href:
