+    def _set_choice(self, data, prompt, index):
+        for cb in data.get("callbacks", []):
+            if cb["type"] == "ChoiceCallback" and cb.get("input"):
+                o = {x["name"]: x["value"] for x in cb.get("output", [])}
+                if o.get("prompt") == prompt:
+                    cb["input"][0]["value"] = index
