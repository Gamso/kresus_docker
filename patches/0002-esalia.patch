+    def init_login(self):
+        from base64 import b64decode, b64encode
+        from random import choices
+        from string import digits
+
+        from Cryptodome.Cipher import PKCS1_v1_5
+        from Cryptodome.PublicKey import RSA
+        from woob.browser.exceptions import ClientError
+        from woob.exceptions import BrowserIncorrectPassword
+
+        hdrs = {"Accept-API-Version": "protocol=1.0,resource=2.1"}
+        params = self.build_authentication_params()
+        self.authentication_page.go(json={}, params=params, headers=hdrs)
+        data = self.page.doc
+        callbacks = data.get("callbacks", [])
+
+        def outs(cb):
+            return {o["name"]: o["value"] for o in cb.get("output", [])}
+
+        def find(kind, **cond):
+            for cb in callbacks:
+                if cb["type"] == kind and all(outs(cb).get(k) == v for k, v in cond.items()):
+                    return cb
+            return None
+
+        name_cb = find("NameCallback")
+        pwd_cb = find("PasswordCallback")
+        key_cb = find("HiddenValueCallback", id="publicKey")
+        meta_cb = find("MetadataCallback")
+        if not (name_cb and pwd_cb and key_cb):
+            raise AssertionError("Esalia: formulaire inattendu: %s" % [c["type"] for c in callbacks])
+
+        public_key = outs(key_cb)["value"]
+        meta = outs(meta_cb).get("data", {}) if meta_cb else {}
+        with_salt = not meta.get("ENCRYPT_WITHOUT_SALT", False)
+
+        secret = ("".join(choices(digits, k=24)) if with_salt else "") + self.password
+        cipher = PKCS1_v1_5.new(RSA.import_key(b64decode(public_key)))
+        name_cb["input"][0]["value"] = self.username
+        pwd_cb["input"][0]["value"] = b64encode(cipher.encrypt(secret.encode())).decode()
+        key_cb["input"][0]["value"] = public_key
+
+        try:
+            self.authentication_page.go(json=data, headers=hdrs)
+        except ClientError as e:
+            if e.response.status_code == 401:
+                raise BrowserIncorrectPassword()
+            raise
+        return self.response.json()
+
+    HDRS = {"Accept-API-Version": "protocol=1.0,resource=2.1"}
