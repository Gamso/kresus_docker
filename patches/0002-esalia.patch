+    def _load_tokens_file(self):
+        import json
+
+        try:
+            with open(self.TOKENS_FILE) as f:
+                return json.load(f)
+        except (OSError, ValueError):
+            return None
+
+    def _save_tokens_file(self):
+        import json
+        import os
+
+        try:
+            fd = os.open(self.TOKENS_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+            with os.fdopen(fd, "w") as f:
+                json.dump(self.esalia_tokens, f)
+        except OSError:
+            pass
+
+    def _ensure_token(self):
+        from woob.browser.exceptions import ClientError
+
+        if self.esalia_tokens and self.esalia_tokens.get("access") and self._token_fresh:
+            return
+        from_file = self._load_tokens_file()
+        tokens = from_file or self.esalia_tokens or {}
+        source = "fichier" if from_file else ("session" if self.esalia_tokens else "aucune")
+        if tokens.get("refresh"):
+            try:
+                self._token_request({"grant_type": "refresh_token", "refresh_token": tokens["refresh"]})
+                self.logger.debug("token refreshed (source=%s)", source)
+                return
+            except ClientError as e:
+                er = getattr(e, "response", None)
+                self.logger.debug("token refresh refused: status=%s (source=%s)", getattr(er, "status_code", None), source)
+                self.esalia_tokens = None
+        else:
+            self.logger.debug("no refresh token (source=%s)", source)
+        self.do_login()
+
+    def _api_get(self, href):
+        self._ensure_token()
+        if href.startswith("http"):
+            url = href
+        elif href.startswith("/api/"):
+            url = self.API + href
+        elif href.startswith("/"):
+            url = self.API + "/api/epargnant/v1" + href
+        else:
+            url = self.API + "/api/epargnant/v1/" + href
+        return self.open(url, headers={"Authorization": "Bearer " + self.esalia_tokens["access"]}).json()
