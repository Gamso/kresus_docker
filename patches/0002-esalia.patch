+    def _advance(self, data):
+        from woob.exceptions import NeedInteractiveFor2FA, SentOTPQuestion
+
+        for _ in range(6):
+            if "tokenId" in data:
+                return data
+            stage = data.get("stage")
+            if stage == "DeviceCollect":
+                data = self._submit_device_collect(data)
+            elif stage == "OTPInfo":
+                if not self.is_interactive:
+                    raise NeedInteractiveFor2FA()
+                data = self._submit_as_is(data)
+            elif stage == "OTP":
+                self.otp_json = data
+                data["_kv"] = {"v": self.code_verifier, "s": self.oauth_state}
+                raise SentOTPQuestion("otp", message="Entrez le code de validation recu par SMS ou e-mail")
+            else:
+                raise AssertionError("Esalia: etape non geree: stage=%s structure=%s" % (stage, self._summary(data)))
+        raise AssertionError("Esalia: trop d'etapes, stage=%s" % data.get("stage"))
+
+    def handle_otp(self):
+        from woob.browser.exceptions import ClientError
+        from woob.exceptions import BrowserIncorrectPassword
+
+        data = self.otp_json
+        kv = data.pop("_kv", {})
+        self.code_verifier = kv.get("v")
+        self.oauth_state = kv.get("s")
+        code = self.config["otp"].get()
+        for cb in data["callbacks"]:
+            if cb["type"] == "PasswordCallback" and cb.get("input"):
+                cb["input"][0]["value"] = code
+        self._set_choice(data, "rememberTerminal", 1 if self.REMEMBER_DEVICE else 0)
+        self._set_choice(data, "iam_action", 0)
+        try:
+            self.authentication_page.go(json=data, headers=self.HDRS)
+        except ClientError as e:
+            if e.response.status_code == 401:
+                raise AssertionError(
+                    "Esalia: OTP 401 len=%d digits=%s body=%s"
+                    % (len(code or ""), str(code or "").isdigit(), e.response.text[:300])
+                )
+            raise
+        new = self.response.json()
+        if new.get("stage") == "OTP":
+            err = ""
+            for cb in new.get("callbacks", []):
+                o = {x["name"]: x["value"] for x in cb.get("output", [])}
+                if o.get("id") == "error-iam":
+                    err = str(o.get("value", ""))
+            raise AssertionError(
+                "Esalia: OTP refuse len=%d digits=%s error-iam=%s"
+                % (len(code or ""), str(code or "").isdigit(), err[:200])
+            )
+        self.otp_json = None
+        self._advance(new)
+        self._finish_oauth()
