+    def _export_history(self):
+        """Writes the operations (parts bought and sold per fund) and the unit price history of every fund.
+
+        The number of parts held at any date is the sum of the signed parts of the operations up to that date,
+        which matches the current positions. Refreshed when the number of operations changes or once a day.
+        """
+        import json
+        import os
+        import time
+
+        try:
+            with open(self.HISTORY_FILE) as f:
+                previous = json.load(f)
+        except (OSError, ValueError):
+            previous = None
+
+        transactions, offset = [], 0
+        while offset < 1000:
+            page = self._api_get("/transactions" + ("?offset=%d" % offset if offset else ""))
+            if not isinstance(page, list) or not page:
+                break
+            transactions += page
+            offset += len(page)
+            if len(page) < 10:
+                break
+
+        if (
+            previous
+            and previous.get("transaction_count") == len(transactions)
+            and time.time() - previous.get("generated_at", 0) < self.HISTORY_MAX_AGE
+        ):
+            return
+
+        movements, support_hrefs = [], {}
+        for tx in transactions:
+            href = ((tx.get("_links") or {}).get("instructions") or {}).get("href")
+            if not href:
+                continue
+            day = (tx.get("date_comptabilisation") or tx.get("date_creation") or "")[:10]
+            for ins in self._api_get(href) or []:
+                sid = ins.get("id_support")
+                support_href = ((ins.get("_links") or {}).get("support_investissement") or {}).get("href")
+                if sid and support_href:
+                    support_hrefs[sid] = support_href
+                movements.append(
+                    {
+                        "date": day,
+                        "dispositif": ins.get("id_dispositif"),
+                        "support": sid,
+                        "sens": ins.get("sens"),  # SOUSCRIPTION (parts in) or RACHAT (parts out)
+                        "parts": ins.get("nb_parts") or 0,
+                        "amount": (ins.get("montant_net") or {}).get("montant"),
+                        "type": ins.get("type") or tx.get("type"),
+                    }
+                )
+
+        supports = {}
+        for sid, support_href in support_hrefs.items():
+            support = self._api_get(support_href) or {}
+            history_href = ((support.get("_links") or {}).get("historique_valorisations") or {}).get("href")
+            prices = []
+            for point in (self._api_get(history_href) or []) if history_href else []:
+                value = (point.get("valeur_part") or {}).get("montant")
+                if point.get("date_valeur") and value is not None:
+                    prices.append([point["date_valeur"][:10], value])
+            supports[sid] = {
+                "label": support.get("titre"),
+                "isin": support.get("code_isin"),
+                "prices": sorted(prices),
+            }
+
+        tmp = self.HISTORY_FILE + ".tmp"
+        with open(tmp, "w") as f:
+            json.dump(
+                {
+                    "generated_at": time.time(),
+                    "date": time.strftime("%Y-%m-%d"),
+                    "transaction_count": len(transactions),
+                    "movements": sorted(movements, key=lambda m: m["date"]),
+                    "supports": supports,
+                },
+                f,
+                ensure_ascii=False,
+            )
+        os.replace(tmp, self.HISTORY_FILE)
