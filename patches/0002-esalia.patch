+    def _token_request(self, data):
+        payload = dict(data)
+        payload["client_id"] = self.CLIENT_ID
+        tok = self.open(self.API + "/api/auth/token", data=payload).json()
+        if not tok.get("access_token"):
+            raise AssertionError("Esalia: reponse token sans access_token: %s" % sorted(tok.keys()))
+        self.esalia_tokens = {"access": tok["access_token"], "refresh": tok.get("refresh_token")}
+        self._token_fresh = True
+        self._save_tokens_file()
+
+    def _finish_oauth(self):
+        from urllib.parse import parse_qs, urljoin, urlsplit
+
+        r = self.open(self.redirect_uri, allow_redirects=False)
+        loc, hops = r.headers.get("Location", ""), 0
+        while loc and not loc.startswith(self.CALLBACK) and hops < 5:
+            r = self.open(urljoin(r.url, loc), allow_redirects=False)
+            loc, hops = r.headers.get("Location", ""), hops + 1
+        q = parse_qs(urlsplit(loc).query)
+        code = (q.get("code") or [None])[0]
+        if not code or (q.get("state") or [None])[0] != self.oauth_state:
+            raise AssertionError("Esalia: retour OAuth2 inattendu (status=%s code=%s)" % (r.status_code, bool(code)))
+        self._token_request({
+            "grant_type": "authorization_code",
+            "code_verifier": self.code_verifier,
+            "redirect_uri": self.CALLBACK,
+            "code": code,
+        })
+
