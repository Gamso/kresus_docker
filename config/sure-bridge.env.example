# Copy to config/sure-bridge.env (mounted read-only in the sure-bridge container).
# Never commit the real file. Then apply changes with: docker compose restart sure-bridge

SURE_URL=http://sure.example.lan:3000
SURE_API_KEY=REPLACE_ME

# Kresus: name of the service in docker-compose.yml
KRESUS_URL=http://kresus:9876

# Exact account names in Sure (leave empty to skip)
SURE_ACCOUNT_PEA=My PEA
SURE_ACCOUNT_PEE=My PEE
SURE_ACCOUNT_SAVINGS=My savings account
SURE_ACCOUNT_CHECKING=My checking account
# Crypto (account of type Crypto, empty before the first send): the Binance and Kraken history from crypto-ledger.py.
# Coins sent: BTC, ETH, BNB, USDC (securities CRYPTO:BTC...); another one: CRYPTO_TICKER_<COIN>=CRYPTO:<COIN>
SURE_ACCOUNT_CRYPTO=Crypto
# Every day is sent, each reward on its date; CRYPTO_MIN_EUR=1 groups the additions under 1 EUR instead
#CRYPTO_MIN_EUR=0

# Kresus account to read: a word of its label, prefixed with the bank (Woob module name:
# fortuneo, bp...) when needed. The prefix is required as soon as two banks share a label.
# `sure-bridge.py accounts` lists every Kresus account as bank:label.
KRESUS_SAVINGS_MATCH=fortuneo:livret a
KRESUS_CHECKING_MATCH=fortuneo:compte courant

# Extra accounts, numbered from 1:
#   SURE_LINK_<n>=<savings|checking|loan>|<[bank:]word of the Kresus label>|<exact Sure account name>
#   savings  : daily balance only
#   checking : transactions (deduplicated) + daily balance
#   loan     : daily outstanding principal, as a positive amount (Sure account of type Loan)
SURE_LINK_1=loan|bp:my loan 1|Home loan 1
SURE_LINK_2=loan|bp:my loan 2|Home loan 2

# PEE: "valuation" (one global balance) or "lines" (one line per fund with gain).
# To switch to "lines", first delete the existing valuation of the PEE account in Sure.
PEE_MODE=valuation

# PEE history (valuation mode only): 1 = on the next sync, also send one valuation per past date, rebuilt from the
# Esalia operations and unit price history (parts held x unit price). Sent once, then only the missing days.
# Needs one Esalia sync in Kresus after the upgrade, so that the module writes esalia-history.json.
PEE_HISTORY=0

# crypto-ledger.py: read-only Binance API key (API Management: "Enable Reading" only, nothing else)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# crypto-ledger.py: read-only Kraken API key (only "Query Funds" and "Query Ledger Entries")
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Cost of a crypto-for-crypto trade: carry (the cost follows the coins: cost = EUR put in, like Koinly pfu_france)
# or market (each coin is a separate line: a sale at the market price, the gain or loss is realized)
#CRYPTO_LEDGER_METHOD=carry
